                        <engine:VisualElement style="flex-grow: 0; background-image: url(&quot;project://database/Assets/Sprites/AssetsJungleMission.png?fileID=-4746810112206747960&amp;guid=b4a1c8e0f69d54c498d5fdac224af5c6&amp;type=3#AssetsJungleMission_9&quot;); width: 30px; height: 30px; align-items: auto; align-content: auto; justify-content: flex-start; flex-direction: row; margin-left: 30px;" />
