                    <engine:Label text="RANKING" style="margin-top: 0; margin-right: 10px; margin-bottom: 0; margin-left: 10px; padding-top: 0; padding-right: 10px; padding-bottom: 0; padding-left: 10px; translate: 0 0; -unity-text-align: middle-center; height: 62px; position: absolute; top: 0; width: 100%; left: auto; align-content: center; align-self: stretch; justify-content: space-around; flex-direction: row; align-items: center;">
