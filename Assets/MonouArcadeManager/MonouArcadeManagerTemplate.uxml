                <engine:Button text="INSCRÍBETE" name="notReady_registerButton" style="margin-top: 0; display: flex; background-image: url(&quot;project://database/Assets/Sprites/AssetsJungleMission.png?fileID=6316850266847647224&amp;guid=b4a1c8e0f69d54c498d5fdac224af5c6&amp;type=3#AssetsJungleMission_23&quot;); -unity-background-image-tint-color: rgb(255, 255, 255); padding-right: 30px; padding-top: 50px; padding-bottom: 50px; padding-left: 30px; font-size: 20px;" />
                <engine:Button text="TUTORIAL" name="notReady_tutorialButton" style="background-image: url(&quot;project://database/Assets/Sprites/AssetsJungleMission.png?fileID=6316850266847647224&amp;guid=b4a1c8e0f69d54c498d5fdac224af5c6&amp;type=3#AssetsJungleMission_23&quot;); margin-bottom: 50px; padding-top: 50px; padding-bottom: 50px; padding-right: 40px; padding-left: 40px; margin-top: 0; font-size: 20px;" />
