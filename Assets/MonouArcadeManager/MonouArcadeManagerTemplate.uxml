    <engine:ScrollView name="content" horizontal-scroller-visibility="Hidden" style="justify-content: space-between; align-self: stretch; background-image: url(&quot;project://database/Assets/Sprites/AssetsJungleMission.png?fileID=-2802281494249029300&amp;guid=b4a1c8e0f69d54c498d5fdac224af5c6&amp;type=3#AssetsJungleMission_3&quot;);">
