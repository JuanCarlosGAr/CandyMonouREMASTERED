                <engine:Label text="EL TORNEO TERMINA EN:" style="color: rgb(185, 185, 185); margin-top: 0; font-size: 12px; -unity-font-style: normal; padding-bottom: 10px; width: 244px; margin-bottom: 15px;" />
                <engine:Label text="00d 00h 00m" name="alReady_timerText" style="padding-bottom: 20px; background-position-y: center 0; -unity-text-align: lower-center; font-size: 28px; justify-content: flex-start; align-content: stretch; margin-top: 10px; margin-bottom: -10px; width: 386px;" />
                <engine:Label text="Recuerda que gana quien haga el mejor score durante las 72 hrs de vigencia del torneo." style="-unity-font-style: normal; font-size: 12px; padding-top: 0; padding-right: 0; padding-bottom: 40px; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 319px; -unity-font-definition: resource(&apos;Fonts &amp; Materials/Poppins-SemiBold&apos;);" />
